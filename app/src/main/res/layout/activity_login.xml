<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_modern_mesh">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Lottie Animation Container (Preserved) -->
        <FrameLayout
            android:id="@+id/loginAnimationContainer"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/loginAnimationPreview"
                android:layout_width="160dp"
                android:layout_height="140dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:scaleType="centerInside"
                android:src="@drawable/utomo_logo_mark" />
        </FrameLayout>

        <!-- Figma Header: Sign In -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/auth_sign_in_title"
            android:textColor="@color/figma_text_title"
            android:textSize="26sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/poppins_regular"
            android:text="@string/auth_sign_in_subtitle"
            android:textColor="@color/figma_text_muted"
            android:textSize="14sp" />

        <!-- Form Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_figma_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/auth_username_label"
                android:textColor="@color/figma_text_title"
                android:textSize="13sp" />

            <!-- Protected Input: username with valid checkmark -->
            <RelativeLayout
                android:id="@+id/containerUsername"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_figma_input">

                <EditText
                    android:id="@+id/username"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/poppins_regular"
                    android:hint="@string/auth_username_hint"
                    android:inputType="textEmailAddress"
                    android:paddingStart="14dp"
                    android:paddingEnd="44dp"
                    android:textColor="@color/figma_text_title"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/iconUsernameValid"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/ic_check_circle_green"
                    android:visibility="gone" />
            </RelativeLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/label_password"
                android:textColor="@color/figma_text_title"
                android:textSize="13sp" />

            <!-- Protected Input: password with valid checkmark and visibility toggle -->
            <RelativeLayout
                android:id="@+id/containerPassword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_figma_input">

                <EditText
                    android:id="@+id/password"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/poppins_regular"
                    android:hint="@string/auth_password_hint"
                    android:inputType="textPassword"
                    android:paddingStart="14dp"
                    android:paddingEnd="74dp"
                    android:textColor="@color/figma_text_title"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/iconPasswordValid"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="6dp"
                    android:layout_toStartOf="@id/btnTogglePassword"
                    android:src="@drawable/ic_check_circle_green"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/btnTogglePassword"
                    android:layout_width="44dp"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/toggle_password_visibility"
                    android:padding="11dp"
                    android:src="@drawable/ic_eye_off"
                    app:tint="@color/figma_text_muted" />
            </RelativeLayout>

            <!-- Remember me & Forgot Password -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/poppins_regular"
                android:text="@string/remember_me"
                    android:textColor="@color/figma_text_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnForgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/poppins_semibold"
                android:text="@string/forgot_password"
                    android:textColor="@color/figma_primary"
                    android:textSize="13sp" />
            </RelativeLayout>

            <!-- Login Button -->
            <TextView
                android:id="@+id/buttonLogin"
                style="@style/FigmaButtonPrimary"
                android:layout_marginTop="20dp"
                android:text="@string/login_button" />

            <!-- Google Login Button -->
            <LinearLayout
                android:id="@+id/btnGoogleSignIn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_figma_input"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_google" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="@string/auth_google"
                    android:textColor="@color/figma_text_title"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Biometric & PIN login options -->
            <LinearLayout
                android:id="@+id/layoutAlternativeAuth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnQuickPin"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_figma_input"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/auth_pin_login"
                        android:textColor="@color/figma_primary"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnQuickFingerprint"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_figma_input"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_figma_fingerprint"
                        app:tint="@color/figma_primary" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/auth_biometric"
                        android:textColor="@color/figma_primary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Don't have an account link -->
        <TextView
            android:id="@+id/textGoToRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:fontFamily="@font/poppins_medium"
            android:text="@string/auth_register_prompt"
            android:textColor="@color/figma_primary"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
