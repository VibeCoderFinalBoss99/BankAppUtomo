<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_modern_mesh"
    android:orientation="vertical">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_figma_arrow_back"
            android:padding="6dp" />

        <TextView
            android:id="@+id/withdrawHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/poppins_semibold"
            android:text="Cash Withdrawal"
            android:textColor="@color/figma_text_title"
            android:textSize="18sp" />
    </RelativeLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- STEP 1 & 2: Account & Amount Selection (Withdraw #1 & #2) -->
        <ScrollView
            android:id="@+id/stepAmountView"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Source Account"
                    android:textColor="@color/figma_text_muted"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

                <!-- Source Account Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_blue_wave"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:text="Utomo Debit Card"
                        android:textColor="#CCFFFFFF"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/poppins_bold"
                        android:text="Rp 24.500.000"
                        android:textColor="@android:color/white"
                        android:textSize="22sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/poppins_regular"
                        android:text="**** **** **** 8821"
                        android:textColor="#CCFFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Select Withdrawal Amount"
                    android:textColor="@color/figma_text_muted"
                    android:textSize="13sp"
                    android:layout_marginBottom="12dp" />

                <!-- Quick Amount Grid -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="3"
                    android:alignmentMode="alignMargins"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/chipAmount100"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_figma_card"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Rp 100.000"
                        android:textColor="@color/figma_text_title"
                        android:textSize="14sp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chipAmount200"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_figma_card"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Rp 200.000"
                        android:textColor="@color/figma_text_title"
                        android:textSize="14sp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chipAmount500"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_figma_card"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Rp 500.000"
                        android:textColor="@color/figma_text_title"
                        android:textSize="14sp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chipAmount1000"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_figma_card"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Rp 1.000.000"
                        android:textColor="@color/figma_text_title"
                        android:textSize="14sp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chipAmount1500"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_figma_card"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Rp 1.500.000"
                        android:textColor="@color/figma_text_title"
                        android:textSize="14sp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chipAmount2000"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_figma_card"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Rp 2.000.000"
                        android:textColor="@color/figma_text_title"
                        android:textSize="14sp"
                        android:clickable="true"
                        android:focusable="true" />
                </GridLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Or Enter Other Amount (Multiples of Rp 50.000)"
                    android:textColor="@color/figma_text_muted"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/inputCustomAmount"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_figma_input"
                    android:fontFamily="@font/poppins_medium"
                    android:hint="Rp 0"
                    android:inputType="number"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/figma_text_title"
                    android:textSize="16sp"
                    android:layout_marginBottom="24dp" />

                <!-- ATM Location Selector (Withdraw #3) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Select ATM Location"
                    android:textColor="@color/figma_text_muted"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/btnSelectAtm"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_figma_card"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="32dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_figma_atm"
                        app:tint="@color/figma_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/textSelectedAtm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_medium"
                            android:text="Any UTOMO Bank / Prima ATM"
                            android:textColor="@color/figma_text_title"
                            android:textSize="13sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="Near you • No card needed"
                            android:textColor="@color/figma_text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/btnProceedWithdraw"
                    style="@style/FigmaButtonPrimary"
                    android:text="Continue to PIN" />
            </LinearLayout>
        </ScrollView>

        <!-- STEP 3: PIN Verification (Withdraw #4 & #5) -->
        <LinearLayout
            android:id="@+id/stepPinView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:text="Enter Security PIN"
                android:textColor="@color/figma_text_title"
                android:textSize="20sp"
                android:layout_marginTop="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:text="Enter your 6-digit transaction PIN to generate the cardless withdrawal code"
                android:textColor="@color/figma_text_muted"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="32dp" />

            <EditText
                android:id="@+id/inputWithdrawPin"
                android:layout_width="220dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_figma_input"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center"
                android:hint="••••••"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:letterSpacing="0.3"
                android:textColor="@color/figma_text_title"
                android:textSize="24sp"
                android:layout_marginBottom="32dp" />

            <TextView
                android:id="@+id/btnConfirmWithdrawPin"
                style="@style/FigmaButtonPrimary"
                android:text="Generate Withdrawal Code" />
        </LinearLayout>

        <!-- STEP 4: Withdrawal Code & Instructions (Withdraw #6) -->
        <ScrollView
            android:id="@+id/stepCodeView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center_horizontal">

                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_tile_soft_green"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="16dp">
                    <com.airbnb.lottie.LottieAnimationView
                        tools:ignore="MissingClass"
                        android:id="@+id/lottieWithdrawSuccessAnim"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:layout_gravity="center" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Withdrawal Code Ready"
                    android:textColor="@color/figma_text_title"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/textWithdrawnAmountSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Rp 500.000"
                    android:textColor="@color/figma_primary"
                    android:textSize="24sp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="24dp" />

                <!-- Withdrawal Token Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_figma_card"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:text="Cash Withdrawal Code"
                        android:textColor="@color/figma_text_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/textWithdrawalCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:text="849 201"
                        android:textColor="@color/figma_text_title"
                        android:textSize="34sp"
                        android:letterSpacing="0.1"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_regular"
                        android:text="Valid for 60 minutes"
                        android:textColor="@color/bank_red"
                        android:textSize="12sp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <!-- Steps Guide -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_figma_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="28dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="How to Withdraw at ATM:"
                        android:textColor="@color/figma_text_title"
                        android:textSize="14sp"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_regular"
                        android:text="1. Visit the nearest UTOMO Bank or Prima ATM."
                        android:textColor="@color/figma_text_muted"
                        android:textSize="12sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_regular"
                        android:text="2. Select 'Cardless Transaction' on the ATM screen."
                        android:textColor="@color/figma_text_muted"
                        android:textSize="12sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_regular"
                        android:text="3. Enter your registered mobile phone number."
                        android:textColor="@color/figma_text_muted"
                        android:textSize="12sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_regular"
                        android:text="4. Enter the 6-digit withdrawal code shown above."
                        android:textColor="@color/figma_text_muted"
                        android:textSize="12sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_regular"
                        android:text="5. Collect your cash from the dispenser."
                        android:textColor="@color/figma_text_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnDoneWithdraw"
                    style="@style/FigmaButtonPrimary"
                    android:text="Done / Back to Home" />
            </LinearLayout>
        </ScrollView>

    </FrameLayout>
</LinearLayout>
