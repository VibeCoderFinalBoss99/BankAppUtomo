<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="24dp"
    android:background="@drawable/bg_figma_card"
    android:elevation="12dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="28dp">

    <!-- Lottie Animated Status Icon (Success Check / Failure Alert) -->
    <FrameLayout
        android:id="@+id/feedbackIconContainer"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_tile_soft_green">

        <com.airbnb.lottie.LottieAnimationView
            tools:ignore="MissingClass"
            android:id="@+id/lottieFeedbackAnim"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- Feedback Title -->
    <TextView
        android:id="@+id/textFeedbackTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_semibold"
        android:text="Payment Successful"
        android:textAlignment="center"
        android:textColor="@color/figma_text_title"
        android:textSize="20sp" />

    <!-- Feedback Message / Details -->
    <TextView
        android:id="@+id/textFeedbackMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="Your transaction has been processed securely."
        android:textColor="@color/figma_text_body"
        android:textSize="13sp" />

    <!-- Reference Code Badge -->
    <TextView
        android:id="@+id/textFeedbackReference"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_tile_soft_blue"
        android:fontFamily="@font/poppins_medium"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:text="REF: TX-893120"
        android:textColor="@color/figma_primary"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Action Button (Done / Close) -->
    <TextView
        android:id="@+id/btnFeedbackAction"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_figma_button_primary"
        android:fontFamily="@font/poppins_semibold"
        android:gravity="center"
        android:text="Done"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:clickable="true"
        android:focusable="true" />
</LinearLayout>
