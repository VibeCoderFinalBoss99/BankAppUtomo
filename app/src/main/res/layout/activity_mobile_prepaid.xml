<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_modern_mesh"
    android:orientation="vertical">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_figma_arrow_back"
            android:padding="6dp" />

        <TextView
            android:id="@+id/rechargeHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/mobile_topup"
            android:textColor="@color/figma_text_title"
            android:textSize="18sp" />
    </RelativeLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- STEP 1 & 2: Input & Denomination Selection -->
        <ScrollView
            android:id="@+id/viewInputStep"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/label_phone"
                    android:textColor="@color/figma_text_muted"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

                <!-- Phone input with prefix & contact icon -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_figma_input"
                    android:layout_marginBottom="16dp">

                    <EditText
                        android:id="@+id/inputPhoneNumber"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/poppins_medium"
                        android:hint="0812 3456 7890"
                        android:inputType="phone"
                        android:paddingStart="14dp"
                        android:paddingEnd="48dp"
                        android:textColor="@color/figma_text_title"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/btnPickContact"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="6dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_user"
                        app:tint="@color/figma_primary" />
                </RelativeLayout>

                <!-- Quick Beneficiaries -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/mobile_recent_numbers"
                    android:textColor="@color/figma_text_muted"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:id="@+id/recentContact1"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_figma_card"
                        android:fontFamily="@font/poppins_regular"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Push (08123456789)"
                        android:textColor="@color/figma_text_title"
                        android:textSize="12sp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/recentContact2"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_figma_card"
                        android:fontFamily="@font/poppins_regular"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Olivia (08567891234)"
                        android:textColor="@color/figma_text_title"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Tabs: Airtime vs Data Package -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_figma_input"
                    android:padding="4dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tabAirtime"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_figma_tab_active"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/mobile_pulsa_tab"
                        android:textColor="@android:color/white"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tabData"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_medium"
                        android:text="@string/mobile_data_tab"
                        android:textColor="@color/figma_text_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Denominations Grid -->
                <GridLayout
                    android:id="@+id/gridDenominations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="3"
                    android:layout_marginBottom="32dp">

                    <LinearLayout
                        android:id="@+id/denom25"
                        android:layout_width="0dp"
                        android:layout_height="68dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_figma_card"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="Rp 25.000"
                            android:textColor="@color/figma_text_title"
                            android:textSize="15sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="@string/mobile_price_25"
                            android:textColor="@color/figma_text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/denom50"
                        android:layout_width="0dp"
                        android:layout_height="68dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_figma_card"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="Rp 50.000"
                            android:textColor="@color/figma_text_title"
                            android:textSize="15sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="@string/mobile_price_50"
                            android:textColor="@color/figma_text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/denom100"
                        android:layout_width="0dp"
                        android:layout_height="68dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_figma_card"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="Rp 100.000"
                            android:textColor="@color/figma_text_title"
                            android:textSize="15sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="@string/mobile_price_100"
                            android:textColor="@color/figma_text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/denom200"
                        android:layout_width="0dp"
                        android:layout_height="68dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_figma_card"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="Rp 200.000"
                            android:textColor="@color/figma_text_title"
                            android:textSize="15sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="@string/mobile_price_200"
                            android:textColor="@color/figma_text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/denom300"
                        android:layout_width="0dp"
                        android:layout_height="68dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_figma_card"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="Rp 300.000"
                            android:textColor="@color/figma_text_title"
                            android:textSize="15sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="@string/mobile_price_300"
                            android:textColor="@color/figma_text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/denom500"
                        android:layout_width="0dp"
                        android:layout_height="68dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_figma_card"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="Rp 500.000"
                            android:textColor="@color/figma_text_title"
                            android:textSize="15sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="@string/mobile_price_500"
                            android:textColor="@color/figma_text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>
                </GridLayout>

                <TextView
                    android:id="@+id/btnProceedRecharge"
                    style="@style/FigmaButtonPrimary"
                    android:text="@string/mobile_continue_payment" />
            </LinearLayout>
        </ScrollView>

        <!-- STEP 3: Confirmation Sheet & PIN (Recharge the phone #3 - Confirm #1 & #2) -->
        <ScrollView
            android:id="@+id/viewConfirmStep"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="@string/mobile_payment_confirmation"
                    android:textColor="@color/figma_text_title"
                    android:textSize="18sp"
                    android:layout_marginBottom="16dp" />

                <!-- Detail card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_figma_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="24dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="32dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="@string/label_phone"
                            android:textColor="@color/figma_text_muted" />
                        <TextView
                            android:id="@+id/textConfirmPhone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="0812 3456 7890"
                            android:textColor="@color/figma_text_title" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="32dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="@string/mobile_provider"
                            android:textColor="@color/figma_text_muted" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:fontFamily="@font/poppins_medium"
                            android:text="Telkomsel Prepaid"
                            android:textColor="@color/figma_text_title" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="32dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="@string/mobile_denomination"
                            android:textColor="@color/figma_text_muted" />
                        <TextView
                            android:id="@+id/textConfirmDenom"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="Rp 100.000"
                            android:textColor="@color/figma_text_title" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="32dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="@string/admin_fee"
                            android:textColor="@color/figma_text_muted" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:fontFamily="@font/poppins_medium"
                            android:text="Rp 1.500"
                            android:textColor="@color/figma_text_title" />
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/figma_divider"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="32dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="@string/total_payment"
                            android:textColor="@color/figma_text_title"
                            android:textSize="15sp" />
                        <TextView
                            android:id="@+id/textConfirmTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:fontFamily="@font/poppins_bold"
                            android:text="Rp 101.500"
                            android:textColor="@color/figma_primary"
                            android:textSize="17sp" />
                    </RelativeLayout>
                </LinearLayout>

                <!-- PIN Input Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/enter_security_pin"
                    android:textColor="@color/figma_text_muted"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/inputRechargePin"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_figma_input"
                    android:fontFamily="@font/poppins_bold"
                    android:gravity="center"
                    android:hint="••••••"
                    android:inputType="numberPassword"
                    android:maxLength="6"
                    android:letterSpacing="0.2"
                    android:textColor="@color/figma_text_title"
                    android:textSize="20sp"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:id="@+id/btnConfirmRecharge"
                    style="@style/FigmaButtonPrimary"
                    android:text="@string/mobile_confirm_pay"
                    android:layout_marginBottom="12dp" />

                <!-- Biometric shortcut -->
                <LinearLayout
                    android:id="@+id/btnUseFingerprint"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_figma_card"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_figma_fingerprint"
                        app:tint="@color/figma_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/poppins_medium"
                        android:text="@string/mobile_pay_fingerprint"
                        android:textColor="@color/figma_primary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- STEP 4: Success Receipt (Recharge the phone #4) -->
        <ScrollView
            android:id="@+id/viewSuccessStep"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center_horizontal">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_figma_check"
                    app:tint="@color/figma_secondary"
                    android:background="@drawable/bg_tile_soft_green"
                    android:padding="12dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/mobile_topup_success"
                    android:textColor="@color/figma_text_title"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/textReceiptTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Rp 101.500"
                    android:textColor="@color/figma_primary"
                    android:textSize="26sp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="24dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_figma_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="28dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="32dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="@string/mobile_transaction_id"
                            android:textColor="@color/figma_text_muted" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:fontFamily="@font/poppins_medium"
                            android:text="TX-99824102"
                            android:textColor="@color/figma_text_title" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="32dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="@string/label_phone"
                            android:textColor="@color/figma_text_muted" />
                        <TextView
                            android:id="@+id/textReceiptPhone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:fontFamily="@font/poppins_medium"
                            android:text="0812 3456 7890"
                            android:textColor="@color/figma_text_title" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="32dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="@string/mobile_serial_token"
                            android:textColor="@color/figma_text_muted" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:fontFamily="@font/poppins_medium"
                            android:text="2819 0491 8839 2109"
                            android:textColor="@color/figma_text_title" />
                    </RelativeLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/btnDoneRecharge"
                    style="@style/FigmaButtonPrimary"
                    android:text="@string/back_to_home" />
            </LinearLayout>
        </ScrollView>

    </FrameLayout>
</LinearLayout>
