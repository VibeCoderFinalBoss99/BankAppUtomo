<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_top_rounded"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- Icon & Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_tile_soft_blue">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_figma_shield_check"
                app:tint="@color/figma_primary" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/poppins_bold"
            android:text="Login Cepat PIN"
            android:textColor="@color/figma_text_title"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center"
            android:text="Masukkan 6 angka PIN keamanan akun UTOMO Bank Anda."
            android:textColor="@color/figma_text_muted"
            android:textSize="12.5sp" />
    </LinearLayout>

    <!-- PIN Input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_figma_input"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <EditText
            android:id="@+id/inputLoginPin"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:hint="• • • • • •"
            android:imeOptions="actionDone"
            android:inputType="numberPassword"
            android:letterSpacing="0.4"
            android:maxLength="6"
            android:textColor="@color/figma_text_title"
            android:textColorHint="@color/figma_text_muted"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Action Buttons -->
    <TextView
        android:id="@+id/btnLoginWithPin"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_figma_button_primary"
        android:fontFamily="@font/poppins_semibold"
        android:gravity="center"
        android:text="Masuk ke Akun"
        android:textColor="@android:color/white"
        android:textSize="14.5sp"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/btnCancelLoginPin"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="@font/poppins_medium"
        android:gravity="center"
        android:text="Batal"
        android:textColor="@color/figma_text_muted"
        android:textSize="13.5sp"
        android:clickable="true"
        android:focusable="true" />
</LinearLayout>
