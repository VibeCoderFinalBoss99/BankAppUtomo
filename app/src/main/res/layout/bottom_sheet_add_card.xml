<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_top_rounded"
    android:orientation="vertical"
    android:padding="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_bottom_sheet_handle"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_bold"
        android:text="Tambah Kartu Baru"
        android:textColor="@color/figma_text_title"
        android:textSize="18sp"
        android:layout_marginBottom="14dp" />

    <!-- Card Type Selector -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_medium"
        android:text="Jenis Kartu"
        android:textColor="@color/figma_text_muted"
        android:textSize="13sp"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/chipAddCardDebit"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_figma_button_primary"
            android:fontFamily="@font/poppins_semibold"
            android:gravity="center"
            android:text="Debit Card (Visa)"
            android:textColor="@android:color/white"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/chipAddCardCredit"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_figma_card"
            android:fontFamily="@font/poppins_semibold"
            android:gravity="center"
            android:text="Credit Card (Mastercard)"
            android:textColor="@color/figma_text_title"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Theme / Gradient Selector -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_medium"
        android:text="Pilih Tema Warna Kartu"
        android:textColor="@color/figma_text_muted"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <View
            android:id="@+id/colorThemePurpleOrange"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_card_gradient_purple_orange" />

        <View
            android:id="@+id/colorThemeNavyTeal"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_card_gradient_navy_teal" />

        <View
            android:id="@+id/colorThemeAmber"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_gradient_amber_orange" />
    </LinearLayout>

    <!-- Generated Card Number Preview Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_figma_card"
        android:orientation="vertical"
        android:padding="14dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular"
            android:text="Nomor Kartu Baru (Acak/Random):"
            android:textColor="@color/figma_text_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/textPreviewRandomCardNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/poppins_bold"
            android:letterSpacing="0.1"
            android:text="4521 •••• •••• 9021"
            android:textColor="@color/figma_primary"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnSubmitAddCard"
        style="@style/FigmaButtonPrimary"
        android:text="+ Terbitkan &amp; Tambahkan Kartu"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/btnCancelAddCard"
        style="@style/FigmaButtonSecondary"
        android:text="Batal" />

</LinearLayout>
