<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_sheet_top_rounded"
    android:padding="28dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_bottom_sheet_handle"
        android:layout_marginBottom="24dp" />

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_tile_soft_red"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_lock_closed"
            app:tint="@color/bank_red" />
    </FrameLayout>

    <TextView
        android:id="@+id/textLockedErrorTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/card_blocked_error_title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/figma_text_title"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/textLockedErrorDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/card_blocked_error_desc"
        android:textSize="13sp"
        android:textColor="@color/figma_text_muted"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLockedContactSupport"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/card_contact_support"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        app:cornerRadius="12dp"
        android:backgroundTint="@color/figma_primary"
        android:layout_marginBottom="10dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLockedCancel"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/str_batal"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/figma_text_muted"
        app:cornerRadius="12dp"
        android:backgroundTint="@android:color/transparent"
        app:strokeColor="@color/figma_border"
        app:strokeWidth="1dp" />

</LinearLayout>
