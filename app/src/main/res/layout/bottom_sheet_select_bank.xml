<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bankBottomSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_sheet_top_rounded"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <!-- Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- Header (Title, Subtitle, Close) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@+id/btnCloseBankPicker"
            android:layout_marginEnd="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textBankDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/select_bank_dialog_title"
                android:textColor="@color/figma_text_title"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppins_regular"
                android:text="@string/select_bank_subtitle"
                android:textColor="@color/figma_text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnCloseBankPicker"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            app:tint="@color/figma_text_muted" />
    </RelativeLayout>

    <!-- Search Input Box -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_figma_input"
        android:paddingStart="14dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/iconBankSearch"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="Search"
            android:src="@drawable/ic_search"
            app:tint="@color/figma_text_muted" />

        <EditText
            android:id="@+id/inputSearchBank"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp"
            android:layout_toStartOf="@+id/btnClearBankSearch"
            android:layout_toEndOf="@+id/iconBankSearch"
            android:background="@android:color/transparent"
            android:fontFamily="@font/poppins_regular"
            android:hint="@string/search_bank_hint"
            android:imeOptions="actionDone"
            android:inputType="textCapWords"
            android:singleLine="true"
            android:textColor="@color/figma_text_title"
            android:textColorHint="@color/figma_text_muted"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/btnClearBankSearch"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Clear"
            android:padding="5dp"
            android:src="@drawable/ic_close"
            android:visibility="gone"
            app:tint="@color/figma_text_muted" />
    </RelativeLayout>

    <!-- Popular Banks (Quick Chips) -->
    <LinearLayout
        android:id="@+id/layoutPopularBanks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/popular_banks"
            android:textColor="@color/figma_text_muted"
            android:textSize="12sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/containerPopularBanks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Bank List Header -->
    <TextView
        android:id="@+id/textBankCountHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="@string/all_banks"
        android:textColor="@color/figma_text_muted"
        android:textSize="12sp" />

    <!-- Bank Items Recycler List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerBanks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        android:paddingBottom="8dp" />

    <!-- Empty State View -->
    <LinearLayout
        android:id="@+id/layoutEmptyBank"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_tile_soft_blue">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="Not Found"
                android:src="@drawable/ic_search"
                app:tint="@color/figma_primary" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/bank_not_found_title"
            android:textColor="@color/figma_text_title"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textEmptyDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center"
            android:text="@string/bank_not_found_desc"
            android:textColor="@color/figma_text_muted"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
