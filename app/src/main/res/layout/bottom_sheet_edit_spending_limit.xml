<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_top_rounded"
    android:orientation="vertical"
    android:padding="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_bottom_sheet_handle"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_bold"
        android:text="Atur Batas Pengeluaran Bulanan"
        android:textColor="@color/figma_text_title"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/textCurrentSpentSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_regular"
        android:text="Pengeluaran bulan ini: Rp 0"
        android:textColor="@color/figma_primary"
        android:textSize="13sp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_medium"
        android:text="Batas Maksimal Pengeluaran (Rp)"
        android:textColor="@color/figma_text_muted"
        android:textSize="13sp"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/inputSpendingLimit"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_figma_input"
        android:fontFamily="@font/poppins_bold"
        android:hint="Rp 15.000.000"
        android:inputType="number"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/figma_text_title"
        android:textColorHint="@color/figma_text_muted"
        android:textSize="16sp"
        android:layout_marginBottom="14dp" />

    <!-- Quick Chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/chipLimit5M"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_figma_card"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:text="5 Juta"
            android:textColor="@color/figma_text_title"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/chipLimit10M"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_figma_card"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:text="10 Juta"
            android:textColor="@color/figma_text_title"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/chipLimit15M"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_figma_button_primary"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:text="15 Juta"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/chipLimit25M"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_figma_card"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:text="25 Juta"
            android:textColor="@color/figma_text_title"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnSaveSpendingLimit"
        style="@style/FigmaButtonPrimary"
        android:text="Simpan Batas Pengeluaran"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/btnCancelSpendingLimit"
        style="@style/FigmaButtonSecondary"
        android:text="Batal" />

</LinearLayout>
