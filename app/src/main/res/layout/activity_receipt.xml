<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_modern_mesh"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="36dp">

        <!-- Top Navigation Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/btnReceiptBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_tile_soft_blue"
                android:padding="8dp"
                android:src="@drawable/ic_figma_arrow_back"
                app:tint="@color/figma_text_title"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/poppins_semibold"
                android:text="Bukti Transaksi"
                android:textColor="@color/figma_text_title"
                android:textSize="18sp" />
        </RelativeLayout>

        <!-- ============================================================== -->
        <!-- CAPTURE AREA: Only this Card is rendered for Image & PDF Share -->
        <!-- ============================================================== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardReceiptCaptureArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/figma_border"
            app:cardBackgroundColor="@color/figma_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Receipt Header with UTOMO Bank Logo -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="24dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/utomo_logo_mark" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/poppins_bold"
                            android:text="BANK UTOMO"
                            android:textColor="@color/figma_primary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/poppins_medium"
                        android:text="E-RECEIPT"
                        android:textColor="@color/figma_text_muted"
                        android:textSize="11sp" />
                </RelativeLayout>

                <!-- Lottie Success Animation & Status Badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/lottieReceiptStatus"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginBottom="8dp" />

                    <!-- Status Chip -->
                    <TextView
                        android:id="@+id/textReceiptStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tile_soft_green"
                        android:fontFamily="@font/poppins_bold"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="TRANSAKSI BERHASIL"
                        android:textColor="@color/bank_success"
                        android:textSize="11sp" />

                    <!-- Prominent Total Amount -->
                    <TextView
                        android:id="@+id/textReceiptTotalAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/poppins_bold"
                        android:text="Rp 287.500"
                        android:textColor="@color/figma_text_title"
                        android:textSize="26sp" />

                    <TextView
                        android:id="@+id/textReceiptDateTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/poppins_regular"
                        android:text="13 Okt 2026, 14:30 WIB"
                        android:textColor="@color/figma_text_muted"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <!-- Tear-off Divider Decoration -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="24dp">

                    <!-- Left punch hole -->
                    <View
                        android:layout_width="16dp"
                        android:layout_height="24dp"
                        android:layout_alignParentStart="true"
                        android:background="@drawable/bg_screen_modern_mesh" />

                    <!-- Dashed line -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="24dp"
                        android:layout_marginEnd="24dp"
                        android:background="@color/figma_divider" />

                    <!-- Right punch hole -->
                    <View
                        android:layout_width="16dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_screen_modern_mesh" />
                </RelativeLayout>

                <!-- Key-Value Transaction Details -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="20dp">

                    <!-- 1. Transaction Type -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="Jenis Transaksi"
                            android:textColor="@color/figma_text_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/textReceiptType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="Transfer Antar Bank"
                            android:textColor="@color/figma_text_title"
                            android:textSize="12sp" />
                    </RelativeLayout>

                    <!-- 2. Reference Number -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="No. Referensi"
                            android:textColor="@color/figma_text_muted"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:id="@+id/btnReceiptCopyRef"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:id="@+id/textReceiptRefNo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="TRX-20261013-8829"
                                android:textColor="@color/figma_primary"
                                android:textSize="12sp" />

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginStart="4dp"
                                android:src="@drawable/ic_figma_copy"
                                app:tint="@color/figma_primary" />
                        </LinearLayout>
                    </RelativeLayout>

                    <!-- 3. Sender -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="Pengirim"
                            android:textColor="@color/figma_text_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/textReceiptSender"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:fontFamily="@font/poppins_medium"
                            android:text="Push Puttichai (**** 7890)"
                            android:textColor="@color/figma_text_title"
                            android:textSize="12sp" />
                    </RelativeLayout>

                    <!-- 4. Recipient / Counterparty -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:id="@+id/labelReceiptRecipient"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="Penerima"
                            android:textColor="@color/figma_text_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/textReceiptRecipient"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="PLN Postpaid"
                            android:textColor="@color/figma_text_title"
                            android:textSize="12sp" />
                    </RelativeLayout>

                    <!-- 5. Recipient Account / ID -->
                    <RelativeLayout
                        android:id="@+id/rowReceiptRecipientAccount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:id="@+id/labelReceiptRecipientAccount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="No. Rekening / ID"
                            android:textColor="@color/figma_text_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/textReceiptRecipientAccount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:fontFamily="@font/poppins_medium"
                            android:text="5123 **** 8901"
                            android:textColor="@color/figma_text_title"
                            android:textSize="12sp" />
                    </RelativeLayout>

                    <!-- 6. Bank Name -->
                    <RelativeLayout
                        android:id="@+id/rowReceiptBank"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="Bank Penerima"
                            android:textColor="@color/figma_text_muted"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/imageReceiptBankLogo"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="6dp"
                                android:adjustViewBounds="true"
                                android:scaleType="fitCenter"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/textReceiptBank"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_medium"
                                android:text="@string/utomo_bank_name"
                                android:textColor="@color/figma_text_title"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </RelativeLayout>

                    <!-- 7. QRIS Merchant Details (if applicable) -->
                    <RelativeLayout
                        android:id="@+id/rowReceiptQrisDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="NMID / Acquirer"
                            android:textColor="@color/figma_text_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/textReceiptQrisDetails"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:fontFamily="@font/poppins_medium"
                            android:text="ID1020021982901 • ASPI"
                            android:textColor="@color/figma_text_title"
                            android:textSize="12sp" />
                    </RelativeLayout>

                    <!-- 8. Note -->
                    <RelativeLayout
                        android:id="@+id/rowReceiptNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="Catatan"
                            android:textColor="@color/figma_text_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/textReceiptNote"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:fontFamily="@font/poppins_medium"
                            android:text="Pembayaran Tagihan"
                            android:textColor="@color/figma_text_title"
                            android:textSize="12sp" />
                    </RelativeLayout>

                    <!-- Breakdown Box -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tile_soft_blue"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Nominal Transaksi"
                                android:textColor="@color/figma_text_body"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/textReceiptBaseAmount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:fontFamily="@font/poppins_medium"
                                android:text="Rp 285.000"
                                android:textColor="@color/figma_text_title"
                                android:textSize="12sp" />
                        </RelativeLayout>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Biaya Layanan / Admin"
                                android:textColor="@color/figma_text_body"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/textReceiptAdminFee"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:fontFamily="@font/poppins_medium"
                                android:text="Rp 2.500"
                                android:textColor="@color/figma_text_title"
                                android:textSize="12sp" />
                        </RelativeLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="8dp"
                            android:background="@color/figma_divider" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_bold"
                                android:text="Total Transaksi"
                                android:textColor="@color/figma_text_title"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/textReceiptBreakdownTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:fontFamily="@font/poppins_bold"
                                android:text="Rp 287.500"
                                android:textColor="@color/figma_primary"
                                android:textSize="13.5sp" />
                        </RelativeLayout>
                    </LinearLayout>

                    <!-- Official Footer -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/poppins_regular"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp"
                        android:text="Resi elektronik ini sah diterbitkan oleh PT UTOMO Bank Indonesia. Berizin dan diawasi oleh OJK serta dijamin oleh LPS."
                        android:textColor="@color/figma_text_muted"
                        android:textSize="9.5sp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================================== -->
        <!-- ACTION BUTTONS: Outside capture card (never shown in image)    -->
        <!-- ============================================================== -->

        <!-- Row 1: Share Image & Share PDF -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Share as Image -->
            <LinearLayout
                android:id="@+id/btnShareReceiptImage"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_figma_button_primary"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_send"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Bagikan Gambar"
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Share as PDF -->
            <LinearLayout
                android:id="@+id/btnShareReceiptPdf"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_tile_soft_blue"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_figma_document"
                    app:tint="@color/figma_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Unduh PDF"
                    android:textColor="@color/figma_primary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: Save to Gallery -->
        <LinearLayout
            android:id="@+id/btnSaveReceiptGallery"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_figma_button_secondary"
            android:gravity="center"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_card"
                app:tint="@color/figma_text_title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="Simpan ke Galeri Foto"
                android:textColor="@color/figma_text_title"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Row 3: Make another transaction & Done -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Make Another Transaction -->
            <TextView
                android:id="@+id/btnReceiptAnother"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_figma_button_secondary"
                android:fontFamily="@font/poppins_semibold"
                android:gravity="center"
                android:text="Transaksi Lagi"
                android:textColor="@color/figma_text_title"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Done (Return) -->
            <TextView
                android:id="@+id/btnReceiptDone"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_figma_button_primary"
                android:fontFamily="@font/poppins_semibold"
                android:gravity="center"
                android:text="Selesai"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
