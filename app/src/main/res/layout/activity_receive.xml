<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_modern_mesh"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/btnReceiveBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_tile_soft_blue"
                android:padding="8dp"
                android:src="@drawable/ic_figma_arrow_back"
                app:tint="@color/figma_text_title"
                android:clickable="true"
                android:focusable="true" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="14dp"
                android:layout_toEndOf="@id/btnReceiveBack"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textReceiveTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Terima Dana"
                    android:textColor="@color/figma_text_title"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="QRIS &amp; Transfer Rekening"
                    android:textColor="@color/figma_text_muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Shareable QR & Account Card (This view hierarchy is captured for Share & Gallery) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardQrCaptureArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/glass_card_stroke"
            app:cardBackgroundColor="@color/figma_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="20dp">

                <!-- Header inside Card: UTOMO Bank Logo & QRIS Badge -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/utomo_logo_mark" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/poppins_bold"
                            android:text="BANK UTOMO"
                            android:textColor="@color/figma_primary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_tile_soft_blue"
                        android:fontFamily="@font/poppins_bold"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:text="QRIS STANDAR"
                        android:textColor="@color/figma_primary"
                        android:textSize="10sp" />
                </RelativeLayout>

                <!-- High Resolution Dynamic QR Code Image -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="230dp"
                    android:layout_height="230dp"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/figma_border"
                    app:cardBackgroundColor="@color/white">

                    <ImageView
                        android:id="@+id/imgReceiveQr"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="QRIS Code" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Requested Amount Pill (Shown if requested) -->
                <LinearLayout
                    android:id="@+id/containerRequestedAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_tile_soft_green"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/textRequestedAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:text="Nominal: Rp 150.000"
                        android:textColor="@color/bank_success"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/textRequestedNote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_regular"
                        android:text="Catatan: Makan Siang"
                        android:textColor="@color/figma_text_muted"
                        android:textSize="10.5sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Account Holder Name & Details -->
                <TextView
                    android:id="@+id/textReceiveAccountHolder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Push Puttichai"
                    android:textColor="@color/figma_text_title"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="@string/digital_account_brand"
                    android:textColor="@color/figma_text_muted"
                    android:textSize="12sp" />

                <!-- Account Number Box with Tap-to-Copy -->
                <LinearLayout
                    android:id="@+id/btnQuickCopyAccount"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_tile_soft_blue"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/textReceiveAccountNumber"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_bold"
                        android:letterSpacing="0.06"
                        android:text="1278 8989 390"
                        android:textColor="@color/figma_primary"
                        android:textSize="14.5sp" />

                    <ImageView
                        android:id="@+id/iconCopyState"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_figma_copy"
                        app:tint="@color/figma_primary" />

                    <TextView
                        android:id="@+id/textCopiedFeedback"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Salin"
                        android:textColor="@color/figma_primary"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/poppins_regular"
                    android:gravity="center"
                    android:text="Dapat dipindai dari BCA, Mandiri, BRI, BNI, GoPay, OVO, DANA, ShopeePay &amp; semua bank nasional."
                    android:textColor="@color/figma_text_muted"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Request Amount Expandable Section ("Minta Nominal Tertentu") -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/glass_card_stroke"
            app:cardBackgroundColor="@color/glass_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Toggle Header -->
                <RelativeLayout
                    android:id="@+id/btnToggleRequestAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/iconAmountBadge"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_tile_soft_blue"
                        android:padding="6dp"
                        android:src="@drawable/ic_wallet"
                        app:tint="@color/figma_primary" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="12dp"
                        android:layout_toEndOf="@id/iconAmountBadge"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="Tentukan Nominal (Opsional)"
                            android:textColor="@color/figma_text_title"
                            android:textSize="13.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="Buat QR khusus dengan jumlah dana tertentu"
                            android:textColor="@color/figma_text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/arrowToggleRequest"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="@color/figma_text_muted" />
                </RelativeLayout>

                <!-- Expandable Input Fields Container -->
                <LinearLayout
                    android:id="@+id/containerAmountInputs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:text="Nominal yang Diminta (IDR)"
                        android:textColor="@color/figma_text_body"
                        android:textSize="12sp" />

                    <!-- IDR Amount Input -->
                    <EditText
                        android:id="@+id/inputRequestAmount"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_figma_input"
                        android:fontFamily="@font/poppins_semibold"
                        android:hint="Rp 0"
                        android:inputType="number"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="@color/figma_text_title"
                        android:textColorHint="@color/figma_text_muted"
                        android:textSize="15sp" />

                    <!-- Quick Amount Chips -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <TextView
                            android:id="@+id/chipAmount50k"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_tile_soft_blue"
                            android:fontFamily="@font/poppins_medium"
                            android:gravity="center"
                            android:text="50 Ribu"
                            android:textColor="@color/figma_primary"
                            android:textSize="11.5sp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/chipAmount100k"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_weight="1"
                            android:layout_marginStart="2dp"
                            android:layout_marginEnd="2dp"
                            android:background="@drawable/bg_tile_soft_blue"
                            android:fontFamily="@font/poppins_medium"
                            android:gravity="center"
                            android:text="100 Ribu"
                            android:textColor="@color/figma_primary"
                            android:textSize="11.5sp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/chipAmount250k"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/bg_tile_soft_blue"
                            android:fontFamily="@font/poppins_medium"
                            android:gravity="center"
                            android:text="250 Ribu"
                            android:textColor="@color/figma_primary"
                            android:textSize="11.5sp"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/poppins_medium"
                        android:text="Catatan Transfer (Opsional)"
                        android:textColor="@color/figma_text_body"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/inputRequestNote"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_figma_input"
                        android:fontFamily="@font/poppins_regular"
                        android:hint="Contoh: Iuran Kas, Makan Siang"
                        android:inputType="textCapSentences"
                        android:maxLength="40"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="@color/figma_text_title"
                        android:textColorHint="@color/figma_text_muted"
                        android:textSize="13sp" />

                    <!-- Apply & Reset Button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnResetRequestAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:fontFamily="@font/poppins_medium"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="Hapus Nominal"
                            android:textColor="@color/bank_red"
                            android:textSize="12sp"
                            android:clickable="true"
                            android:focusable="true" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/btnApplyRequestAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_figma_button_primary"
                            android:fontFamily="@font/poppins_semibold"
                            android:gravity="center"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp"
                            android:text="Terapkan ke QR"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Primary Action Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Share QR & Account Image Sheet Button -->
            <LinearLayout
                android:id="@+id/btnShareQrImage"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_figma_button_primary"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_send"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Bagikan QR"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Save to Gallery Button -->
            <LinearLayout
                android:id="@+id/btnSaveQrGallery"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_figma_button_secondary"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_figma_document"
                    app:tint="@color/figma_text_title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Simpan Gambar"
                    android:textColor="@color/figma_text_title"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
