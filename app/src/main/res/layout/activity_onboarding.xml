<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/source_b_surface">

    <!-- Top Bar with Skip -->
    <RelativeLayout
        android:id="@+id/onboardingTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/utomo_logo_mark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/app_name"
                android:textColor="@color/figma_primary"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnSkipOnboarding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:fontFamily="@font/poppins_medium"
            android:padding="8dp"
            android:text="@string/onboarding_skip"
            android:textColor="@color/figma_text_muted"
            android:textSize="14sp" />
    </RelativeLayout>

    <!-- ViewPager2 for Slides -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pagerOnboarding"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/layoutBottomControls"
        android:layout_below="@id/onboardingTopBar" />

    <!-- Bottom Controls: Next Button -->
    <LinearLayout
        android:id="@+id/layoutBottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="36dp">

        <!-- Action Button (Next - Slides 1 and 2) -->
        <TextView
            android:id="@+id/btnNextOnboarding"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_figma_button_primary"
            android:fontFamily="@font/poppins_semibold"
            android:gravity="center"
            android:text="@string/onboarding_next"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <!-- Action Buttons (Slide 3: Register or Login) -->
        <LinearLayout
            android:id="@+id/layoutAuthButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnRegisterOnboarding"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_figma_button_primary"
                android:fontFamily="@font/poppins_semibold"
                android:gravity="center"
                android:text="@string/onboarding_register"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnLoginOnboarding"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_figma_button_secondary"
                android:fontFamily="@font/poppins_semibold"
                android:gravity="center"
                android:text="@string/onboarding_login"
                android:textColor="@color/figma_primary"
                android:textSize="15sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
