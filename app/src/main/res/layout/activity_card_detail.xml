<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_modern_mesh"
    android:orientation="vertical">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_figma_arrow_back"
            android:padding="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/card_detail_title"
            android:textColor="@color/figma_text_title"
            android:textSize="18sp" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Semi-Transparent Luxury Glass Card Banner -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:strokeWidth="1dp"
                app:strokeColor="#33FFFFFF">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/figma_card_01" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone"
                        android:background="#2E0A122E" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone"
                        android:padding="20dp">

                        <LinearLayout
                            android:id="@+id/cardDetailTopRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_figma_chip" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_contactless" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/cardDetailNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/cardDetailTopRow"
                            android:layout_marginTop="14dp"
                            android:fontFamily="@font/poppins_medium"
                            android:letterSpacing="0.12"
                            android:text="4562  1122  4595  7852"
                            android:textColor="@color/white"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/cardDetailBalance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:fontFamily="@font/poppins_bold"
                            android:text="Rp 24.500.000"
                            android:textColor="@color/white"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/cardDetailHolderName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_above="@id/imgVisaDetail"
                            android:layout_alignParentEnd="true"
                            android:layout_marginBottom="4dp"
                            android:fontFamily="@font/poppins_medium"
                            android:text="@string/sample_card_holder"
                            android:textColor="#B0C4DE"
                            android:textSize="12sp" />

                        <ImageView
                            android:id="@+id/imgVisaDetail"
                            android:layout_width="40dp"
                            android:layout_height="24dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            android:src="@drawable/ic_figma_mastercard" />
                    </RelativeLayout>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card Details Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_figma_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/poppins_regular"
                        android:text="@string/card_status"
                        android:textColor="@color/figma_text_muted" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/active"
                        android:textColor="@color/bank_success" />
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/figma_border" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/poppins_regular"
                        android:text="@string/expires"
                        android:textColor="@color/figma_text_muted" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/poppins_medium"
                        android:text="08/29"
                        android:textColor="@color/figma_text_title" />
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/figma_border" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/poppins_regular"
                        android:text="@string/cvv"
                        android:textColor="@color/figma_text_muted" />
                    <TextView
                        android:id="@+id/textCvv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/poppins_medium"
                        android:text="•••"
                        android:textColor="@color/figma_text_title" />
                </RelativeLayout>
            </LinearLayout>

            <!-- Card Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_figma_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/poppins_medium"
                        android:text="@string/online_transactions"
                        android:textColor="@color/figma_text_title" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchOnlineTx"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:checked="true" />
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/figma_border" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/poppins_medium"
                        android:text="@string/freeze_card_temporarily"
                        android:textColor="@color/figma_text_title" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchFreeze"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />
                </RelativeLayout>

                <!-- Staff Blocked Notice & Action -->
                <LinearLayout
                    android:id="@+id/layoutStaffBlockedNotice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_tile_soft_red"
                    android:padding="12dp"
                    android:layout_marginTop="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/textStaffBlockedNotice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/card_blocked_error_desc"
                        android:textSize="12sp"
                        android:textColor="@color/bank_red"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginBottom="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnContactSupportForCard"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="@string/card_contact_support"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        app:cornerRadius="8dp"
                        android:backgroundTint="@color/figma_primary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Change PIN Button -->
            <TextView
                android:id="@+id/btnChangePin"
                style="@style/FigmaButtonSecondary"
                android:text="@string/change_card_pin" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
