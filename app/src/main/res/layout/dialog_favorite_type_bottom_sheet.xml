<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/choose_favorite_type"
        android:textColor="@color/bank_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/choose_favorite_type_subtitle"
        android:textColor="@color/bank_muted"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/optionBankFavorite"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginTop="18dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_qr_button"
            android:contentDescription="@string/app_name"
            android:padding="10dp"
            android:src="@drawable/ic_bank"
            app:tint="@color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="@string/choose_bank_account"
            android:textColor="@color/bank_text"
            android:textSize="16sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bank_line" />

    <LinearLayout
        android:id="@+id/optionEwalletFavorite"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_qr_button"
            android:contentDescription="@string/app_name"
            android:padding="10dp"
            android:src="@drawable/ic_wallet"
            app:tint="@color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="@string/choose_ewallet"
            android:textColor="@color/bank_text"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
