<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ewalletItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_bank_item_normal"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <!-- E-Wallet Icon -->
    <FrameLayout
        android:id="@+id/frameEWalletIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_figma_card">

        <ImageView
            android:id="@+id/imageEWalletLogo"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <!-- E-Wallet Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textEWalletName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_semibold"
            android:maxLines="1"
            android:text="GoPay"
            android:textColor="@color/figma_text_title"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textEWalletSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_regular"
            android:maxLines="1"
            android:text="GoPay Indonesia • Transfer Instan"
            android:textColor="@color/figma_text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Selection indicator check -->
    <ImageView
        android:id="@+id/imageEWalletCheckSelected"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="Selected"
        android:src="@drawable/ic_figma_check"
        android:visibility="gone"
        app:tint="@color/figma_primary" />

    <!-- Chevron -->
    <ImageView
        android:id="@+id/imageEWalletChevron"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="Go"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/figma_text_muted" />

</LinearLayout>
