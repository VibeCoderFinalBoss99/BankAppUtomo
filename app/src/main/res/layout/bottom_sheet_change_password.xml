<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_top_rounded"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- Icon & Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_tile_soft_blue">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_figma_shield_check"
                app:tint="@color/figma_primary" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/poppins_bold"
            android:text="Ubah Kata Sandi"
            android:textColor="@color/figma_text_title"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center"
            android:text="Buat kata sandi baru minimal 8 karakter dengan kombinasi huruf dan angka."
            android:textColor="@color/figma_text_muted"
            android:textSize="12.5sp" />
    </LinearLayout>

    <!-- New Password Field -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="6dp"
        android:fontFamily="@font/poppins_medium"
        android:text="Kata Sandi Baru"
        android:textColor="@color/figma_text_title"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_figma_input"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="8dp">

        <EditText
            android:id="@+id/inputNewPassword"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="@font/poppins_regular"
            android:hint="Minimal 8 karakter"
            android:imeOptions="actionNext"
            android:inputType="textPassword"
            android:textColor="@color/figma_text_title"
            android:textColorHint="@color/figma_text_muted"
            android:textSize="13.5sp" />

        <ImageView
            android:id="@+id/btnToggleNewPassword"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/toggle_password_visibility"
            android:padding="6dp"
            android:src="@drawable/ic_eye_off"
            app:tint="@color/figma_text_muted" />
    </LinearLayout>

    <!-- Confirm Password Field -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="6dp"
        android:fontFamily="@font/poppins_medium"
        android:text="Konfirmasi Kata Sandi"
        android:textColor="@color/figma_text_title"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_figma_input"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="8dp">

        <EditText
            android:id="@+id/inputConfirmPassword"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="@font/poppins_regular"
            android:hint="Ulangi kata sandi baru"
            android:imeOptions="actionDone"
            android:inputType="textPassword"
            android:textColor="@color/figma_text_title"
            android:textColorHint="@color/figma_text_muted"
            android:textSize="13.5sp" />

        <ImageView
            android:id="@+id/btnToggleConfirmPassword"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/toggle_password_visibility"
            android:padding="6dp"
            android:src="@drawable/ic_eye_off"
            app:tint="@color/figma_text_muted" />
    </LinearLayout>

    <!-- Action Buttons -->
    <TextView
        android:id="@+id/btnSaveNewPassword"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_figma_button_primary"
        android:fontFamily="@font/poppins_semibold"
        android:gravity="center"
        android:text="Simpan Kata Sandi"
        android:textColor="@android:color/white"
        android:textSize="14.5sp"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/btnCancelPassword"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="@font/poppins_medium"
        android:gravity="center"
        android:text="Batal"
        android:textColor="@color/figma_text_muted"
        android:textSize="13.5sp"
        android:clickable="true"
        android:focusable="true" />
</LinearLayout>
