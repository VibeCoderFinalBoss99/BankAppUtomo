<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <!-- Slide Illustration -->
    <ImageView
        android:id="@+id/imgOnboarding"
        android:layout_width="290dp"
        android:layout_height="270dp"
        android:layout_marginTop="16dp"
        android:scaleType="fitCenter" />

    <!-- Indicator Dots placed directly between illustration and title as per Figma -->
    <LinearLayout
        android:id="@+id/layoutSlideDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="28dp"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:id="@+id/slideDot0"
            android:layout_width="24dp"
            android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_figma_button_primary" />

        <View
            android:id="@+id/slideDot1"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_onboarding_dot_inactive" />

        <View
            android:id="@+id/slideDot2"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_onboarding_dot_inactive" />
    </LinearLayout>

    <!-- Slide Title -->
    <TextView
        android:id="@+id/textOnboardingTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center"
        android:textColor="@color/figma_text_title"
        android:textSize="22sp"
        android:lineSpacingExtra="4dp" />

    <!-- Slide Subtitle -->
    <TextView
        android:id="@+id/textOnboardingSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:textColor="@color/figma_text_muted"
        android:textSize="13sp"
        android:lineSpacingExtra="4dp" />

</LinearLayout>
