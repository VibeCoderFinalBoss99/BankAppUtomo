<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_figma_card"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:elevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/textTicketCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Masalah Kartu"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/figma_primary"
            android:background="@drawable/bg_tile_soft_blue"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/textTicketStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Terbuka"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/figma_warning"
            android:background="@drawable/bg_tile_soft_yellow"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/textTicketSubject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Permintaan pembukaan blokir kartu ATM"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/figma_text_title"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/textTicketDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="13 Okt 2026, 14:30"
            android:textSize="12sp"
            android:textColor="@color/figma_text_muted" />

        <View
            android:id="@+id/dotUnreadIndicator"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_badge_new"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
