<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_top_rounded">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="32dp">

        <!-- Drag Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_bottom_sheet_handle" />

        <!-- Header Title & Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/edit_profile_sheet_title"
            android:textColor="@color/figma_text_title"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/poppins_regular"
            android:text="@string/edit_profile_sheet_subtitle"
            android:textColor="@color/figma_text_muted"
            android:textSize="12.5sp" />

        <!-- Avatar Preview with Badge -->
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="12dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgEditAvatarPreview"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:scaleType="centerCrop"
                android:src="@drawable/source_b_avatar"
                android:elevation="4dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

            <FrameLayout
                android:id="@+id/btnBadgePickPhoto"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignEnd="@id/imgEditAvatarPreview"
                android:layout_alignBottom="@id/imgEditAvatarPreview"
                android:background="@drawable/bg_qr_fab"
                android:elevation="6dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_camera"
                    app:tint="@android:color/white" />
            </FrameLayout>
        </RelativeLayout>

        <!-- Preset Avatar Selector Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/poppins_medium"
            android:text="@string/preset_avatar_title"
            android:textColor="@color/figma_text_title"
            android:textSize="13sp" />

        <!-- Preset Avatars Horizontal List -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutPresetAvatars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <!-- Avatar 1: source_b_avatar -->
                <FrameLayout
                    android:id="@+id/presetWrap1"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_avatar_ring_selected"
                    android:padding="3dp"
                    android:clickable="true"
                    android:focusable="true">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/presetImg1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/source_b_avatar"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
                </FrameLayout>

                <!-- Avatar 2: avatar_push -->
                <FrameLayout
                    android:id="@+id/presetWrap2"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_marginEnd="10dp"
                    android:padding="3dp"
                    android:clickable="true"
                    android:focusable="true">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/presetImg2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/avatar_push"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
                </FrameLayout>

                <!-- Avatar 3: avatar_olivia -->
                <FrameLayout
                    android:id="@+id/presetWrap3"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_marginEnd="10dp"
                    android:padding="3dp"
                    android:clickable="true"
                    android:focusable="true">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/presetImg3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/avatar_olivia"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
                </FrameLayout>

                <!-- Avatar 4: avatar_emma -->
                <FrameLayout
                    android:id="@+id/presetWrap4"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_marginEnd="10dp"
                    android:padding="3dp"
                    android:clickable="true"
                    android:focusable="true">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/presetImg4"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/avatar_emma"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
                </FrameLayout>

                <!-- Avatar 5: avatar_justin -->
                <FrameLayout
                    android:id="@+id/presetWrap5"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_marginEnd="10dp"
                    android:padding="3dp"
                    android:clickable="true"
                    android:focusable="true">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/presetImg5"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/avatar_justin"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
                </FrameLayout>

                <!-- Avatar 6: avatar_alexander -->
                <FrameLayout
                    android:id="@+id/presetWrap6"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:padding="3dp"
                    android:clickable="true"
                    android:focusable="true">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/presetImg6"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/avatar_alexander"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
                </FrameLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Choose from Gallery Button -->
        <LinearLayout
            android:id="@+id/btnPickFromGallery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill_accent"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_camera"
                app:tint="@color/figma_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/btn_upload_photo"
                android:textColor="@color/figma_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Form: Full Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/poppins_medium"
            android:text="@string/label_full_name"
            android:textColor="@color/figma_text_muted"
            android:textSize="12.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_figma_input"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_user"
                app:tint="@color/figma_text_muted" />

            <EditText
                android:id="@+id/inputEditName"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:background="@null"
                android:fontFamily="@font/poppins_medium"
                android:hint="@string/hint_full_name"
                android:inputType="textPersonName|textCapWords"
                android:textColor="@color/figma_text_title"
                android:textColorHint="@color/figma_text_muted"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Form: Email -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/poppins_medium"
            android:text="@string/label_email"
            android:textColor="@color/figma_text_muted"
            android:textSize="12.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_figma_input"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_figma_document"
                app:tint="@color/figma_text_muted" />

            <EditText
                android:id="@+id/inputEditEmail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:background="@null"
                android:fontFamily="@font/poppins_medium"
                android:hint="@string/hint_email"
                android:inputType="textEmailAddress"
                android:textColor="@color/figma_text_title"
                android:textColorHint="@color/figma_text_muted"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Form: Phone -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/poppins_medium"
            android:text="@string/label_phone_number"
            android:textColor="@color/figma_text_muted"
            android:textSize="12.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_figma_input"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_phone"
                app:tint="@color/figma_text_muted" />

            <EditText
                android:id="@+id/inputEditPhone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:background="@null"
                android:fontFamily="@font/poppins_medium"
                android:hint="@string/hint_phone"
                android:inputType="phone"
                android:textColor="@color/figma_text_title"
                android:textColorHint="@color/figma_text_muted"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Save Button -->
        <TextView
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_figma_button_primary"
            android:fontFamily="@font/poppins_semibold"
            android:gravity="center"
            android:text="@string/btn_save_profile"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Cancel Button -->
        <TextView
            android:id="@+id/btnCancelProfile"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:text="@string/cancel"
            android:textColor="@color/figma_text_muted"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</ScrollView>
